{
  "name": "caweb-divi-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/CAWebPublishing/caweb-divi-extension",
  "author": "CAWebPublishing",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "caweb": "caweb",
    "prebuild": "composer i",
    "build": "caweb build --mode production && caweb build",
    "build:dev": "caweb build",
    "icons": "node ./lib/scripts/icon.js",
    "test": "wp-scripts test-unit-js --config ./test-config/jest.config.js",
    "zip": "gulp zip",
    "reset-install": "rm -rf ./package-lock.json ./node_modules/ && npm install"
  },
  "overrides": {
    "@types/codemirror": "^5.60.16"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@caweb/cli": "^1.16.17",
    "@divi/module": "^1.0.2",
    "@divi/module-library": "^1.0.2",
    "@divi/module-utils": "^1.0.2",
    "@divi/types": "^1.0.2",
    "@tinymce/tinymce-react": "^5.0.1",
    "@types/enzyme": "^3.10.18",
    "@types/jest": "^29.5.12",
    "@types/jquery": "^3.5.30",
    "@types/lodash": "^4.17.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/seamless-immutable": "^7.1.19",
    "@types/uuid": "^9.0.8",
    "@types/wordpress__blocks": "^12.5.14",
    "@types/wordpress__i18n": "^3.11.0",
    "@wordpress/hooks": "^3.57.0",
    "@wordpress/i18n": "^4.57.0",
    "babel-loader": "^9.1.3",
    "jscodeshift": "^17.3.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "svgo": "^4.0.0",
    "svgson": "^5.3.1"
  },
  "msw": {
    "workerDirectory": "storybook-assets"
  },
  "optionalDependencies": {
    "win-node-env": "^0.6.1"
  },
  "allowScripts": {
    "@caweb/css-audit-webpack-plugin@2.1.5": true,
    "@parcel/watcher@2.5.6": true,
    "accessibility-checker@4.0.18": true,
    "chromedriver@148.0.1": true,
    "core-js@3.49.0": true,
    "fs-ext-extra-prebuilt@2.2.7": true,
    "fsevents@2.3.3": true,
    "puppeteer@22.15.0": true
  }
}
