{
  "name": "caweb-divi-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/CAWebPublishing/caweb-divi-extension",
  "author": "CAWebPublishing",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "caweb": "caweb",
    "module-json": "node ./lib/module.json.js",
    "prebuild": "composer i",
    "build": "caweb build --mode production --externals false  && caweb build --externals false",
    "build:dev": "caweb build --externals false",
    "icons": "node ./lib/icon.js",
    "test": "wp-scripts test-unit-js --config ./test-config/jest.config.js",
    "zip": "gulp zip",
    "reset-install": "rm -rf ./package-lock.json ./node_modules/ && npm install"
  },
  "overrides": {
    "@types/codemirror": "^5.60.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@caweb/cli": "^1.18.3",
    "@divi/conversion": "^1.0.4",
    "@divi/data": "^1.0.2",
    "@divi/icon-library": "^1.0.2",
    "@divi/module": "^1.0.14",
    "@divi/module-library": "^1.0.15",
    "@divi/module-utils": "^1.0.14",
    "@divi/rest": "^1.0.7",
    "@divi/types": "^1.0.13",
    "@tinymce/tinymce-react": "^5.0.1",
    "@types/enzyme": "^3.10.19",
    "@types/jest": "^29.5.12",
    "@types/jquery": "^3.5.30",
    "@types/lodash": "^4.17.26",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/seamless-immutable": "^7.1.19",
    "@types/uuid": "^9.0.8",
    "@types/wordpress__blocks": "^12.5.14",
    "@types/wordpress__i18n": "^3.11.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/url": "^4.57.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "jscodeshift": "^17.4.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1"
  },
  "msw": {
    "workerDirectory": "storybook-assets"
  },
  "optionalDependencies": {
    "win-node-env": "^0.6.1"
  },
  "allowScripts": {
    "@caweb/css-audit-webpack-plugin@2.1.6": true,
    "@parcel/watcher@2.6.0": true,
    "accessibility-checker@4.0.34": true,
    "chromedriver@155.0.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "fs-ext-extra-prebuilt@2.2.7": true,
    "fsevents@2.3.3": true,
    "puppeteer@25.13.0": true
  }
}
