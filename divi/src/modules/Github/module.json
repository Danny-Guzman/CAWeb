{
  "name": "caweb/github",
  "d4Shortcode": "et_pb_ca_github",
  "title": "Github",
  "titles": "Githubs",
  "moduleIcon": "caweb/module-logo",
  "moduleClassName": "et_pb_ca_github",
  "moduleOrderClassName": "et_pb_ca_github",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "bodyFont": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    
    "title": {
      "type": "object",
      "inlineEditor": "plainText",
      "elementType": "heading",
      "selector": "{{selector}} .title",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "header",
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter a title for the list.",
            "features": {
              "responsive": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 1,
            "component": {
              "props": {
                "fieldLabel": "",
                "groupLabel": "Header",
                "fields": {
                  "headingLevel": {
                    "label": "Title Level",
                    "options": {
                      "h1": {
                        "icon": "divi/h1",
                        "label": "H1"
                      },
                      "h2": {
                        "icon": "divi/h2",
                        "label": "H2"
                      },
                      "h3": {
                        "icon": "divi/h3",
                        "label": "H3"
                      },
                      "h4": {
                        "icon": "divi/h4",
                        "label": "H4"
                      },
                      "h5": {
                        "icon": "divi/h5",
                        "label": "H5"
                      }
                    }
                  },
                  "family": {
                    "render": false
                  },
                  "weight": {
                    "render": false
                  },
                  "weightFineTune": {
                    "render": false
                  },
                  "variationSettings": {
                    "render": false
                  },
                  "style": {
                    "render": false
                  },
                  "capitalization": {
                    "render": false
                  },
                  "textWrap": {
                    "render": false
                  },
                  "writingMode": {
                    "render": false
                  },
                  "hyphens": {
                    "render": false
                  },
                  "columnCount": {
                    "render": false
                  },
                  "size": {
                    "render": false
                  },
                  "lineHeight": {
                    "render": false
                  },
                  "letterSpacing": {
                    "render": false
                  },
                  "color": {
                    "render": false
                  },
                  "textAlign": {
                    "render": false
                  },
                  "textShadowGroup": {
                    "component": {
                      "props": {
                        "fields": {
                          "style": {
                            "render": false
                          }
                        }
                      }
                    }
                  },
                  "textEffectsGroup": {
                    "component": {
                      "props": {
                        "fields": {
                          "fillType": {
                            "render": false
                          },
                          "strokeWidth": {
                            "render": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    
    "request": {
      "type": "object",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "innerContent": {
          "groupType": "into-multiple-groups",
          "groups": {
            "style": {
              "groupType": "group-items",
              "items": {
                "per_page": {
                  "render": true,
                  "groupSlug": "style",
                  "attrName": "request.innerContent",
                  "subName": "per_page",
                  "label": "Maximum # of results",
                  "description": "Enter amount to display per page. Default is 30, Max is 100.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/common-numeric-input",
                    "type": "field",
                    "props": {
                      "min": 1,
                      "max": 100,
                      "step": 1
                    }
                  }
                },
                "repo_type": {
                  "groupSlug": "style",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "repo_type",
                  "label": "Repository Type",
                  "description": "Choose repository type you wish to display.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/select",
                    "type": "field",
                    "props": {
                      "options": {
                        "all": {
                          "label": "All",
                          "value": "all"
                        },
                        "public": {
                          "label": "Public",
                          "value": "public"
                        },
                        "private": {
                          "label": "Private",
                          "value": "private"
                        },
                        "forks": {
                          "label": "Forks",
                          "value": "forks"
                        }
                      }
                    }
                  }
                },
                "pat": {
                  "groupSlug": "style",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "access_token",
                  "label": "Personal Access Token",
                  "description": "This is required for Private Repositories to display.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/text",
                    "type": "field"
                  }
                },
                "email": {
                  "groupSlug": "style",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "email",
                  "label": "Code Request Email",
                  "description": "This is the administrators email that will receive all emails requesting access to private repositories.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/text",
                    "type": "field"
                  }
                },
                "emailBody": {
                  "groupSlug": "style",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "email_body",
                  "label": "Request Email Body",
                  "description": "Coming Soon",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/richtext",
                    "type": "field"
                  }
                }
              }
            },
            "organization": {
              "groupType": "group-items",
              "items": {
                "organization": {
                  "groupSlug": "organization",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "organization",
                  "label": "Organization",
                  "description": "Enter GitHub Organization.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/text",
                    "type": "field"
                  }
                },
                "rate_limit": {
                  "groupSlug": "organization",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "rate_limit",
                  "label": "Increase Rate Limit",
                  "description": "Increase the maximum number of requests users are permitted to make per hour. <a href=\"https://developer.github.com/v3/#rate-limiting\" target=\"_blank\">Rate Limiting</a>.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/toggle",
                    "type": "field"
                  }
                },
                
                "client_id": {
                  "groupSlug": "organization",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "client_id",
                  "label": "Client ID",
                  "description": "Enter GitHub Client ID.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/text",
                    "type": "field"
                  }
                },
      
                "client_secret": {
                  "groupSlug": "organization",
                  "render": true,
                  "attrName": "request.innerContent",
                  "subName": "client_secret",
                  "label": "Client Secret",
                  "description": "Enter GitHub Client Secret.",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/text",
                    "type": "field"
                  }
                },
      
                "definitions": {
                  "groupSlug": "organization",
                  "render": true,
                  "label": "Definitions",
                  "description": "Select which information for each repository you would like to display.",
                  "attrName": "request.innerContent",
                  "subName": "definitions",
                  "features": {
                    "responsive": false
                  },
                  "component": {
                    "name": "divi/checkboxes",
                    "type": "field",
                    "props": {
                      "options": [
                        {
                          "label": "Project Title",
                          "value": "name"
                        },
                        {
                          "label": "Add Link to repositories (Public Repositories Only)",
                          "value": "link"
                        },
                        {
                          "label": "Description",
                          "value": "description"
                        },
                        {
                          "label": "Fork",
                          "value": "fork"
                        },
                        {
                          "label": "Creation Date",
                          "value": "created_at"
                        },
                        {
                          "label": "Updated Date",
                          "value": "updated_at"
                        },
                        {
                          "label": "Language",
                          "value": "language"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups":{
      "header": {
        "panel": "content",
        "priority": 2,
        "groupName": "header",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Header"
            }
          }
      },
      "style": {
        "panel": "content",
        "priority": 2,
        "groupName": "style",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Style"
            }
          }
      },
      "organization": {
        "panel": "content",
        "priority": 3,
        "groupName": "organization",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Organization"
            }
          }
      }
    }
  }
}
