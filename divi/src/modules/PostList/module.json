              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            }
          }
        },
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "priority": 7,
            "groupSlug": "style",
            "attrName": "categories.innerContent",
            "render": true,
            "label": "Select Categories",
            "features": {
              "responsive": false
