            }
          }
        }
      }
    },

    "tags": {
      "type": "object",
      "elementType": "heading",
      "selector": "{{selector}}",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "advanced": {
          "all": {
            "groupType": "group-item",
            "item": {
              "priority": 8,
              "groupSlug": "style",
              "render": true,
              "attrName": "tags.advanced.all",
              "label": "Include All Tags",
              "features": {
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            }
          }
        },
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "priority": 9,
            "groupSlug": "style",
            "render": true,
            "attrName": "tags.innerContent",
            "label": "Select Tags",
            "features": {
              "responsive": false
            },
            "component": {
              "name": "divi/checkboxes",
              "type": "field",
              "props": {
                "options": []
