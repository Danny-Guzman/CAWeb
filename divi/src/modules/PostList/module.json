  "settings": {
    "advanced": "auto",
    "design": "auto",
    "groups": {
      "header": {
        "panel": "content",
        "priority": 1,
        "groupName": "header",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Header"
            }
