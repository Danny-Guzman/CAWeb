{
  "name": "caweb/section-primary",
  "d4Shortcode": "et_pb_ca_section_primary",
  "title": "Section Primary",
  "titles": "Section Primaries",
  "moduleIcon": "caweb/module-logo",
  "moduleClassName": "et_pb_ca_section_primary",
  "moduleOrderClassName": "et_pb_ca_section_primary",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {
            "panel": "design"
          },
          "bodyFont": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },

    "title": {
      "type": "object",
      "inlineEditor": "plainText",
      "elementType": "heading",
      "selector": "{{selector}} .title",
      "attributes": {
        "class": "title"
      },
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "header",
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Define the title for the section.",
            "features": {
              "responsive": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "component": {
              "props": {
                "fieldLabel": "",
                "groupLabel": "Header",
                "fields": {
                  "headingLevel": {
                    "label": "Heading Level",
                    "options": {
                      "h1": {
                        "icon": "divi/h1",
                        "label": "H1"
                      },
                      "h2": {
                        "icon": "divi/h2",
                        "label": "H2"
                      },
                      "h3": {
                        "icon": "divi/h3",
                        "label": "H3"
                      },
                      "h4": {
                        "icon": "divi/h4",
                        "label": "H4"
                      },
                      "h5": {
                        "icon": "divi/h5",
                        "label": "H5"
                      }
                    }
                  },
                  "family": {
                    "render": false
                  },
                  "weight": {
                    "render": false
                  },
                  "weightFineTune": {
                    "render": false
                  },
                  "variationSettings": {
                    "render": false
                  },
                  "style": {
                    "render": false
                  },
                  "capitalization": {
                    "render": false
                  },
                  "textWrap": {
                    "render": false
                  },
                  "writingMode": {
                    "render": false
                  },
                  "hyphens": {
                    "render": false
                  },
                  "columnCount": {
                    "render": false
                  },
                  "size": {
                    "render": false
                  },
                  "lineHeight": {
                    "render": false
                  },
                  "letterSpacing": {
                    "render": false
                  },
                  "color": {
                    "label": "Heading Color"
                  },
                  "textAlign": {
                    "label": "Heading Alignment",
                    "options": {
                      "left": {
                        "icon": "divi/text-align-left",
                        "label": "Left"
                      },
                      "center": {
                        "icon": "divi/text-align-center",
                        "label": "Center"
                      },
                      "right": {
                        "icon": "divi/text-align-right",
                        "label": "Right"
                      }
                    }
                  },
                  "textShadowGroup": {
                    "component": {
                      "props": {
                        "fields": {
                          "style": {
                            "render": false
                          }
                        }
                      }
                    }
                  },
                  "textEffectsGroup": {
                    "component": {
                      "props": {
                        "fields": {
                          "fillType": {
                            "render": false
                          },
                          "strokeWidth": {
                            "render": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    
    "image": {
      "type": "object",
      "elementType": "image",
      "tagName": "img",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "advanced": {
          "position": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image",
              "render": true,
              "label": "Position",
              "attrName": "image.advanced.alignment",
              "features": {
                "responsive": false
              },
              "component": {
                "name": "divi/button-options",
                "type": "field",
                "props":{
                  "options": {
                    "pe-3 float-start": {
                      "icon": "divi/text-align-left",
                      "label": "Left"
                    },
                    "ps-3 float-end": {
                      "icon": "divi/text-align-right",
                      "label": "Right"
                    }
                  }
                }
              }
            }
          },
      
          "fade": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "image",
              "render": true,
              "label": "Animation",
              "attrName": "image.advanced.fade",
              "features": {
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "none": {
                      "label": "None"
                    },
                    "fadeInLeft": {
                      "label": "Fade In Left"
                    },
                    "fadeInRight": {
                      "label": "Fade In Right"
                    }
                  }
                }
              }
            }
          },

          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "body",
              "render": true,
              "priority": 1,
              "label": "Featured Image",
              "attrName": "image.advanced.show",
              "features": {
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {
                  "defaultValue": "on"
                }
              }
            }
          }
        },
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "body",
            "render": true,
            "priority": 2,
            "attrName": "image.innerContent",
            "subName": "src",
            "label": "Image",
            "description": "If defined, this image will be used as the background for this module.",
            "features": {
              "responsive": false
            },
            "component": {
              "name": "divi/upload",
              "type": "field",
              "props": {
                "syncImageData": {
                  "src": true,
                  "id": true,
                  "alt": true,
                  "titleText": false
                }
              }
            }
          }
        }
      }
    },
    
    "link": {
      "type": "object",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "advanced": {
          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "body",
              "attrName": "link.advanced.show",
              "render": true,
              "priority": 3,
              "label": "More Information Button",
              "features": {
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            }
          }
        },
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "body",
            "render": true,
            "priority": 4,
            "label": "Link URL",
            "description": "URL destination for the button",
            "attrName": "link.innerContent",
            "subName": "linkUrl",  
            "features": {
              "responsive": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },

    "content": {
      "type": "object",
      "elementType": "content",
      "inlineEditor": "richtext",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "body",
            "attrName": "content.innerContent",
            "label": "Content",
            "priority": 5,
            "description": "Here you can create the content that will be used within the module.",
            "render": true,
            "features": {
              "responsive": false
            },
            "component": {
              "type": "field",
              "name": "divi/richtext"
            }
          }
        }
      }
    }

  },
  "settings": {
    "advanced": "auto",
    "groups":{
      "header": {
        "panel": "content",
        "priority": 2,
        "groupName": "header",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Header"
            }
          }
      },
      "body": {
        "panel": "content",
        "priority": 2,
        "groupName": "body",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Body"
            }
          }
      },
      
      "headerDesign": {
        "panel": "design",
        "priority": 2,
        "groupName": "headerDesign",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Header"
            }
          }
      },

      "image": {
        "panel": "design",
        "priority": 2,
        "groupName": "image",
        "multiElements": true,
        "component": {
            "name": "divi/composite",
            "props": {
              "groupLabel": "Image"
            }
          }
      }
    }
  }
}
